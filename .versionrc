      "hidden": true
    }
  ],
  "commitUrlFormat": "{{host}}/{{owner}}/{{repository}}/commits/{{hash}}",
  "compareUrlFormat": "{{host}}/{{owner}}/{{repository}}/branches/compare/{{previousTag}}%0D{{currentTag}}#diff",
  "releaseCommitMessageFormat": "build(release): {{currentTag}}"
}
